{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt generate && printf '\\n' > .output/public/.keep",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "upgrade:nuxt": "nuxt upgrade --dedupe",
    "upgrade:deps": "npx npm-check-updates --target=semver --interactive",
    "upgrade:deps:latest": "npx npm-check-updates --target=latest --interactive",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/entypo": "^1.2.1",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/simple-icons": "^1.2.102",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^15.0.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue-router": "^5.5.1"
  },
  "overrides": {
    "fontless": {
      "esbuild": "0.28.2"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
