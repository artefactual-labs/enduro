{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt generate && printf '\\n' > .output/public/.keep",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "upgrade:nuxt": "nuxt upgrade --dedupe",
    "upgrade:deps": "npx npm-check-updates --target=semver --interactive",
    "upgrade:deps:latest": "npx npm-check-updates --target=latest --interactive",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/entypo": "^1.2.1",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/ui": "^4.11.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "fontless": {
      "esbuild": "0.28.1"
    },
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.13.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
