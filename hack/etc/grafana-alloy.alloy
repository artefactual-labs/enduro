logging {
	level = "info"
}

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	timeout         = "1s"
	send_batch_size = 100

	output {
		traces = [otelcol.exporter.otlp.tempo.input, otelcol.exporter.debug.default.input]
	}
}

otelcol.exporter.otlp "tempo" {
	retry_on_failure {
		max_elapsed_time = "1m"
	}

	client {
		endpoint = "grafana-tempo:4317"

		tls {
			insecure = true
		}
	}
}

// Retain trace logging for local development alongside export to Tempo.
otelcol.exporter.debug "default" {
	verbosity = "detailed"
}
